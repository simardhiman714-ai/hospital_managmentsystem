<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services - MediCare</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("partials/navbar") %>


<section class="services-hero">

    <h1>Our Medical Services</h1>

    <p>
        We provide high-quality healthcare services with
        experienced doctors and modern medical facilities.
    </p>

</section>


<section class="services-grid">

    <div class="service-card">
        <h2>🩺 General Checkup</h2>
        <p>Complete health checkups for all age groups.</p>
    </div>

    <div class="service-card">
        <h2>❤️ Cardiology</h2>
        <p>Heart care by experienced cardiologists.</p>
    </div>

    <div class="service-card">
        <h2>🦷 Dental Care</h2>
        <p>Advanced dental treatments and oral care.</p>
    </div>

    <div class="service-card">
        <h2>👁 Eye Care</h2>
        <p>Eye testing, surgery and vision treatment.</p>
    </div>

    <div class="service-card">
        <h2>🧠 Neurology</h2>
        <p>Diagnosis and treatment of neurological disorders.</p>
    </div>

    <div class="service-card">
        <h2>👶 Pediatrics</h2>
        <p>Special healthcare services for children.</p>
    </div>

</section>


<section class="emergency-box">

    <h2>🚑 24×7 Emergency Services</h2>

    <p>
        Our emergency team is available 24 hours a day
        for immediate medical assistance.
    </p>

    <button onclick = "window.location.href=`/contact`">call Emergency</button>"

</section>


<section class="service-process">

    <h1>How It Works</h1>

    <div class="process-grid">

        <div>
            <h2>1️⃣</h2>
            <p>Register</p>
        </div>

        <div>
            <h2>2️⃣</h2>
            <p>Book Appointment</p>
        </div>

        <div>
            <h2>3️⃣</h2>
            <p>Meet Doctor</p>
        </div>

        <div>
            <h2>4️⃣</h2>
            <p>Get Treatment</p>
        </div>

    </div>

</section>
<%- include("partials/footer") %>
</body>
</html>