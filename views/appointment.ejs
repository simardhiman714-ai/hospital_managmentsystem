<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Appointment | MediCare</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("partials/navbar") %>

<!-- Hero Section -->
<section class="appointment-hero">

    <div class="appointment-hero-content">
        <h1>Book Your Appointment</h1>
        <p>
            Schedule your appointment with our experienced doctors.
            We are committed to providing quality healthcare services.
        </p>
    </div>

</section>

<!-- Appointment Form -->
<section class="appointment">

    <div class="appointment-container">

        <div class="appointment-left">

            <h4>BOOK APPOINTMENT</h4>

            <h2>Schedule Your Visit</h2>

            <p>
                Fill in your details below and our team will contact you to confirm your appointment.
            </p>

            <img src="/images/hospital-banner.jpg" alt="Appointment">

        </div>

        <div class="appointment-right">

            <form action="/appointment" method="POST">

                <input type="text" name="name" placeholder="Full Name" required>

                <input type="email" name="email" placeholder="Email Address" required>

                <input type="tel" name="phone" placeholder="Phone Number" required>

                <select name="department" required>
                    <option value="">Select Department</option>
                    <option>Cardiology</option>
                    <option>Neurology</option>
                    <option>Dental Care</option>
                    <option>Pediatrics</option>
                    <option>Orthopedics</option>
                </select>

                <select name="doctor" required>
                    <option value="">Select Doctor</option>
                    <option>Dr. Rahul Sharma</option>
                    <option>Dr. Priya Verma</option>
                    <option>Dr. Aman Gupta</option>
                </select>

                <input type="date" name="date" required>

                <input type="time" name="time" required>

                <textarea name="message" rows="5" placeholder="Describe Your Problem"></textarea>

                <button type="submit" class="btn1">
                    Book Appointment
                </button>

            </form>

        </div>

    </div>

</section>

<%- include("partials/footer") %>

</body>
</html>